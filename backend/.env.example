# Copy to backend/.env and fill in. Never commit .env.

# Meeting-bot provider: meetstream (default) or recall
HORUS_MEET_PROVIDER=meetstream

# MeetStream (https://app.meetstream.ai): API key starts with ms_
MEETSTREAM_API_KEY=
MEETSTREAM_API_URL=https://api.meetstream.ai/api/v1

# Public https URL of a tunnel (ngrok or cloudflared) pointing at HORUS_MEET_LOCAL_PORT on this machine.
# MeetStream posts live transcripts and status webhooks to it and opens the control websocket through it.
HORUS_MEET_PUBLIC_URL=
HORUS_MEET_LOCAL_PORT=8765

# Text-to-speech (ElevenLabs). MeetStream needs raw PCM; pcm_24000 is resampled to 48 kHz locally.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

# Bot identity shown to participants
HORUS_BOT_NAME=Horus AI (recording)

# Recall.ai (only if HORUS_MEET_PROVIDER=recall)
RECALL_API_KEY=
RECALL_REGION=us-west-2
HORUS_MEET_PUBLIC_WS_URL=

# Live transcription inside MeetStream. meetstream_native needs no extra key (default).
# deepgram_sentence is more accurate but needs a Deepgram key saved in the MeetStream dashboard.
HORUS_MEET_TRANSCRIPT=meetstream_native

# Website (Cloudflare, free plan) and automatic intake. Enter with ~/Horus/configure-site; the tools write
# CLOUDFLARE_ACCOUNT_ID, HORUS_SITE_URL and HORUS_INTAKE_TOKEN themselves.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
HORUS_SITE_DOMAIN=horushq.ai
HORUS_SITE_URL=
HORUS_INTAKE_NOTIFY_EMAIL=
HORUS_INTAKE_TOKEN=
# 1 = email the requester an acknowledgement at once; 1 = start the Horus kick-off run unattended
HORUS_INTAKE_AUTO_ACK=1
HORUS_INTAKE_AUTOSTART=1
HORUS_INTAKE_MAX_TURNS=150
# Optional: the address Horus writes from, a verified Gmail "Send mail as" alias such as hello@horushq.ai (default: the Gmail address)
HORUS_MAIL_FROM_ADDRESS=
